# データベース
DATABASE_URL=postgresql+psycopg://kaname:kaname@localhost:5432/kaname

# Google OAuth（Google Cloud Console で発行）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Googleの「承認済みのリダイレクトURI」に登録する値と一致させる
GOOGLE_REDIRECT_URI=https://kaname.ajesta.work/auth/google/callback

# 初回ログイン時に自動的にオーナー登録するメールアドレス（カンマ区切りで追加可能）。
# それ以外のユーザーはログイン画面の「アカウント申請」からオーナーの承認を経て利用者登録される。
OWNER_EMAILS=kasaubunts@gmail.com

# セッションCookie署名用の秘密鍵（十分に長いランダム文字列に変更すること）
SESSION_SECRET_KEY=change-me-to-a-random-secret

# フロントエンドのオリジン（CORS許可・ログイン後のリダイレクト先）
FRONTEND_ORIGIN=https://kaname.ajesta.work

# セッションCookieを発行するドメイン（フロント/APIが別サブドメインの場合は上位ドメインを指定）
COOKIE_DOMAIN=.ajesta.work
COOKIE_SECURE=true
